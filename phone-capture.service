[Unit]
Description=Continuous Pixel screen capture for recordings viewer
After=network-online.target recordings-viewer.service
Wants=network-online.target recordings-viewer.service

[Service]
Type=simple
WorkingDirectory=%h/phone-capture
EnvironmentFile=%h/.config/phone-capture/env
ExecStart=/usr/bin/python3 %h/phone-capture/phone_capture.py --scrcpy-bridge-device pixel-4 --scrcpy-bridge-device pixel-4-xl --scrcpy-rtsp-base rtsp://127.0.0.1:8554 --scrcpy-live-fanout --max-size 1520
Restart=always
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=default.target
